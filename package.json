{
  "name": "@chi-hong22/dsh-latexcp",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web LaTeX formula copy helper: hover a formula to copy its TeX source as $...$ or \\(...\\), with inline/display delimiters auto-matched",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "latex",
    "katex",
    "math"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Chi-hong22/dsh-latexcp.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  }
}
